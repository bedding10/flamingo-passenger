{
  "name": "flamingo-passenger",
  "version": "0.3.0",
  "private": true,
  "main": "index.js",
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "lint": "eslint . --ext .js,.ts,.tsx --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "doctor": "expo-doctor",
    "expo:check": "expo install --check",
    "prebuild:ci": "expo prebuild --clean --no-install",
    "build:js": "expo export --platform all --output-dir dist",
    "release:validate": "node scripts/validate-release.mjs",
    "config:validate": "expo config --type public",
    "ci:validate": "npm run quality:gate && npm run release:validate && npm run config:validate && npm run expo:check && npm run doctor && npm run typecheck && npm run lint",
    "quality:gate": "node scripts/ci/quality-gate.mjs"
  },
  "dependencies": {
    "@expo-google-fonts/cairo": "^0.2.3",
    "@expo-google-fonts/poppins": "^0.2.3",
    "@gorhom/bottom-sheet": "^5.0.6",
    "@react-native-firebase/app": "21.12.3",
    "@react-native-firebase/auth": "21.12.3",
    "@react-native-firebase/crashlytics": "21.12.3",
    "@react-native-firebase/messaging": "21.12.3",
    "@react-navigation/native": "7.0.14",
    "@react-navigation/native-stack": "7.2.0",
    "@shopify/flash-list": "1.7.3",
    "@tanstack/react-query": "5.59.20",
    "axios": "1.7.9",
    "expo": "~52.0.47",
    "expo-application": "~6.0.2",
    "expo-asset": "11.0.5",
    "expo-blur": "~14.0.3",
    "expo-camera": "~16.0.18",
    "expo-dev-client": "~5.0.20",
    "expo-device": "~7.0.3",
    "expo-file-system": "~18.0.12",
    "expo-font": "~13.0.4",
    "expo-haptics": "~14.0.1",
    "expo-image-picker": "~16.0.6",
    "expo-linear-gradient": "~14.0.2",
    "expo-location": "~18.0.10",
    "expo-secure-store": "~14.0.1",
    "expo-updates": "~0.27.5",
    "lucide-react-native": "^0.469.0",
    "react": "18.3.1",
    "react-native": "0.76.9",
    "react-native-gesture-handler": "~2.20.2",
    "react-native-maps": "1.18.0",
    "react-native-mmkv": "2.12.2",
    "react-native-qrcode-svg": "^6.3.2",
    "react-native-reanimated": "~3.16.1",
    "react-native-safe-area-context": "4.12.0",
    "react-native-screens": "~4.4.0",
    "react-native-svg": "15.8.0",
    "socket.io-client": "4.8.1",
    "zustand": "5.0.3"
  },
  "devDependencies": {
    "@babel/core": "7.25.2",
    "@expo/config-plugins": "9.0.17",
    "@types/react": "~18.3.0",
    "babel-preset-expo": "~12.0.0",
    "eas-cli": "21.8.0",
    "eslint": "8.57.0",
    "eslint-config-expo": "8.0.1",
    "expo-build-properties": "~0.13.3",
    "expo-doctor": "1.12.1",
    "fs-extra": "11.4.0",
    "typescript": "~5.3.3"
  },
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "listUnknownPackages": false
      }
    }
  },
  "packageManager": "npm@11.17.0",
  "engines": {
    "node": ">=20.15 <25",
    "npm": ">=10 <12"
  }
}
