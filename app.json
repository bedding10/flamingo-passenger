{
  "expo": {
    "name": "flaminGO",
    "slug": "flamingo-passenger",
    "scheme": "flamingo",
    "version": "0.3.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "platforms": ["ios", "android"],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.flamingo.passenger",
      "associatedDomains": ["applinks:nova-ride-4a1e6.firebaseapp.com"],
      "googleServicesFile": "./GoogleService-Info.plist",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "flaminGO uses your location to set pickup and show ride options.",
        "NSPhotoLibraryUsageDescription": "flaminGO uses your selected photo for your passenger profile.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "buildNumber": "1"
    },
    "android": {
      "package": "com.novaride.passenger",
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "POST_NOTIFICATIONS"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "nova-ride-4a1e6.firebaseapp.com",
              "pathPrefix": "/email-signin"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ],
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "versionCode": 1
    },
    "plugins": [
      "@react-native-firebase/app",
      "expo-secure-store",
      "expo-image-picker",
      "expo-location",
      "@react-native-firebase/crashlytics",
      [
        "expo-build-properties",
        {
          "android": {
            "enableProguardInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "usesCleartextTraffic": false,
            "compileSdkVersion": 35,
            "targetSdkVersion": 35
          },
          "ios": {
            "deploymentTarget": "15.1"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    },
    "splash": {
      "image": "./assets/brand-master-logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "icon": "./assets/app-icon.png",
    "notification": {
      "icon": "./assets/notification-icon.png",
      "color": "#D9A520",
      "androidMode": "default",
      "androidCollapsedTitle": "flaminGO"
    },
    "jsEngine": "hermes"
  }
}
