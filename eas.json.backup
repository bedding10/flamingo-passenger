{
  "cli": {
    "version": ">=21.4.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://backend-diao.onrender.com/api"
      }
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://backend-diao.onrender.com/api",
        "EAS_PROJECT_ID": "ac734c75-f867-4cb8-9884-41eeb9072eb4",
        "GOOGLE_MAPS_ANDROID_API_KEY": "AIzaSyCzfQikZMDWaZ7hWAPmyb4N2wGheFzYsK8",
        "GOOGLE_MAPS_IOS_API_KEY": "AIzaSyClS03ocWouyRtxBegf_SbDTiOJOoXybkM"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "autoIncrement": true,
      "channel": "production",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://backend-diao.onrender.com/api"
      },
      "android": {
        "buildType": "app-bundle"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
