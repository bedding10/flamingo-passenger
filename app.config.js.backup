const read = (name) => process.env[name]?.trim();
const requireNativeConfig = process.env.FLAMINGO_REQUIRE_NATIVE_CONFIG === "1";

module.exports = ({ config }) => {
  const androidMapsKey = read("GOOGLE_MAPS_ANDROID_API_KEY");
  const iosMapsKey = read("GOOGLE_MAPS_IOS_API_KEY");
  const easProjectId = read("EAS_PROJECT_ID");
  const googleServicesJson = read("GOOGLE_SERVICES_JSON");
  const googleServicesInfoPlist = read("GOOGLE_SERVICES_INFO_PLIST");

  if (requireNativeConfig) {
    const missing = [
      ["GOOGLE_MAPS_ANDROID_API_KEY", androidMapsKey],
      ["GOOGLE_MAPS_IOS_API_KEY", iosMapsKey],
      ["EAS_PROJECT_ID", easProjectId],
      ["GOOGLE_SERVICES_JSON", googleServicesJson],
      ["GOOGLE_SERVICES_INFO_PLIST", googleServicesInfoPlist],
    ]
      .filter(([, value]) => !value)
      .map(([name]) => name);
    if (missing.length) {
      throw new Error(
        `Missing protected native configuration: ${missing.join(", ")}`,
      );
    }
  }

  return {
    ...config,
    ios: {
      ...config.ios,
      ...(googleServicesInfoPlist
        ? { googleServicesFile: googleServicesInfoPlist }
        : {}),
      ...(iosMapsKey ? { config: { googleMapsApiKey: iosMapsKey } } : {}),
    },
    android: {
      ...config.android,
      ...(googleServicesJson
        ? { googleServicesFile: googleServicesJson }
        : {}),
      ...(androidMapsKey
        ? { config: { googleMaps: { apiKey: androidMapsKey } } }
        : {}),
    },
    extra: {
      ...config.extra,
      ...(easProjectId ? { eas: { projectId: easProjectId } } : {}),
    },
  };
};
